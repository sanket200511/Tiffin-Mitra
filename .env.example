# ─── Required ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/dabba

# Port for the API server to listen on
PORT=8080

# ─── Session Security ─────────────────────────────────────────────────────────
# A long random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_secret_string

# ─── Optional ─────────────────────────────────────────────────────────────────
# Set to "production" in production environments
NODE_ENV=development
