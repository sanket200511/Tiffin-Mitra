# ─── Required ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/dabba

# Port for the API server to listen on
PORT=8080

# ─── Session Security ─────────────────────────────────────────────────────────
# A long random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_secret_string

# ─── Optional ─────────────────────────────────────────────────────────────────
# Set to "production" in production environments
NODE_ENV=development

# Redis connection URL (used for session storage & cache)
REDIS_URL=redis://default:password@localhost:6379

# Optional keep-alive secret to protect the keep-alive endpoints from unauthorized pings
# KEEPALIVE_SECRET=your_keepalive_secret_key

# ─── Render Keep-Alive ────────────────────────────────────────────────────────
# Set to "true" to have the API server periodically ping itself every 10 minutes
# to prevent Render free-tier from idling out / sleeping.
# Set to "false" (or leave unset) to allow Render to go to sleep after 15 minutes of inactivity to save monthly free hours.
RENDER_KEEP_ALIVE=true

# Optional override for the public URL being pinged (defaults to Render's RENDER_EXTERNAL_URL or https://dabba-api.onrender.com)
# RENDER_KEEP_ALIVE_URL=https://dabba-api.onrender.com
# Optional interval in minutes between self-pings (defaults to 10; max recommended: 14)
# RENDER_KEEP_ALIVE_INTERVAL_MINUTES=10
